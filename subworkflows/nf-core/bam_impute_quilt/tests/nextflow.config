process {
    withName: QUILT_QUILT {
        tag        =  { "${meta.id} ${meta.regionoutPadded}" }
        cpus       = 1 // needed for deterministic output
        ext.args   = { "${params.quilt_args}" }
        ext.prefix = { "${meta.id}_${meta.chr}_${meta.regionoutPadded ? meta.regionoutPadded.replace(':','_') : meta.chr}.quilt" }
    }

    withName: GLIMPSE2_LIGATE {
        ext.prefix = { "${meta.id}_${meta.chr}.ligate" }
    }

    withName: BCFTOOLS_INDEX {
        ext.args   = '--csi'
        publishDir = [enabled: false]
    }
}
