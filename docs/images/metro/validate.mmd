graph LR
    subgraph input [Inputs]
    	posfile[Posfile]
        truth[Truth file]
        impute[Imputed target]
    end

    subgraph prepare [Prepare truth data]
        statstruth[Compute truth stats\nbcftools stats]
        gltruth[Compute genotype likelihood\nbcftools mpileup]
        concatposfile[Concatenate Posfile\nbcftools concat]

        mergegl[Merge all individuals\nbcftools merge]
        concatgl[Concatenate all chr\nbcftools concat]
        annotategl[Set IDs\nbcftools annotate]

        truthvcf[Truth VCF]

        Z_querytruth[Obtain samples names\nbcftools query]
        statspanel[Compute panel stats\nbcftools stats]

		gawktruth[Add .truth suffix\ngawk]

        splittruth[Split truth VCF / sample\nbcftools plugin split]

        gltruth -->|truthbam|mergegl
        mergegl -->|truthbam|concatgl
        concatgl -->|truthbam|annotategl
        annotategl -->|truthbam|truthvcf

		truthvcf -->|truthvcf|statstruth
        truthvcf -->|truthvcf|_empty1
        _empty1 -->|truthvcf|splittruth
        truthvcf -->|truthvcf|Z_querytruth

        concatposfile -->|posfile|statspanel

        Z_querytruth -->|samples|gawktruth
        gawktruth -->|samples|splittruth
    end

    subgraph vcfconcordanceglimpse2 [Compute concordance metrics]
        glimpse2concordance[Compute concordance\nglimpse2 concordance]
        addmetainfos[Add meta informations\ngawk]
        gunzip[Decompress\ngunzip]
        addcolumns[Add meta informations\naddcolumns]
        gawktable[Create summary table\ngawk]

        glimpse2concordance -->|stats| addmetainfos

        glimpse2concordance -->|stats| gunzip
        gunzip -->|stats| addcolumns
        addcolumns -->|stats| gawktable
    end

    subgraph stats [Stats]
    	%%metro number: 4
        multiqc[MultiQC]
        finalcsv[General CSV]
    end

    truth -->|truthvcf|truthvcf
    truth -->|truthbam|gltruth
    posfile -->|posfile|gltruth
    posfile -->|posfile|concatposfile

    concatposfile -->|posfile|glimpse2concordance
    splittruth -->|truthvcf|glimpse2concordance
    impute -->|target|glimpse2concordance

	statspanel -->|stats|multiqc
    statstruth -->|stats|multiqc
    addmetainfos -->|stats|multiqc
    gawktable -->|stats|finalcsv
