%%metro title: Simulation step `--steps simulate`
%%metro line_spread: centered
%%metro diamond_style: straight
%%metro line: bam | BAM inputs | #1BB6AFFF
%%metro line: stats | Stats | #F18046
%%metro grid: split_bam | 1,1
%%metro grid: subsample | 2,0
%%metro grid: coverage | 2,1
%%metro grid: output | 3,0
%%metro grid: report | 3,1

graph LR
	subgraph input [Inputs]
        reads[Input BAMs]
    end

    subgraph split_bam [Split BAMs]
    	%%metro number: 2
    	region[If regions]
        view[samtools\nview]
        merge[samtools\nmerge]
        region -->|bam|view
        view -->|bam| merge
    end

    subgraph _inter [hidden]
        noregion[If no regions]
    end

    subgraph subsample [Downsample to depth]
    	%%metro number: 3
        coverage2[Coverage\n/ region]
        fract[Compute\nfraction]
        view2[Downsample]
        _empty[hidden]
        coverage3[Coverage\nsimulated]
        filterchr2[Filter chr]

        coverage2 -->|bam| fract
        fract  -->|bam| view2
        view2 -->|bam| _empty
        _empty --> |bam| _empty2

        %% should be bam
        view2 -->|stats| coverage3

        coverage3 -->|stats| filterchr2
    end

    subgraph coverage [Compute coverage]
    	%%metro number: 4
        coverage[Global\ncoverage]
        filterchr[Filter chr]
        coverage -->|stats| filterchr
    end

    subgraph output [Outputs]
    	%%metro number: 5
        simbams[Simulated BAMS]
    end

    subgraph report [Report]
    	%%metro number: 6
        multiqc[MultiQC]
    end

    reads -->|bam| region

    reads -->|bam| noregion
    noregion -->|bam| coverage2

    merge -->|bam| coverage2
    merge -->|stats| coverage

    _empty2 -->|bam| simbams

    filterchr -->|stats| multiqc
    filterchr2 -->|stats| multiqc
